{
  "uid": "flowguard-agents-vs-l0",
  "title": "FlowGuard / agents vs L0",
  "description": "Per objective: what the agents do against the L0 baseline, live (Prometheus and the audit log through flowguard.exporter) and scored (results files through evaluation/results_exporter.py).",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "flowguard"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "DSO1 detection: Monitor (L1) vs the frozen alert rules (L0)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Recall by band (replay, dev in-sample)",
      "id": 2,
      "description": "Share of injected runtime incidents with an alert or a flag in [start, end + 60 s]. Dev recordings; thresholds were tuned on them (in-sample). H1 is tested on the held-out set at Step 11.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "flowguard_result{source=\"dso1-replay\",objective=\"DSO1 runtime\",variant=\"primary\",metric=\"recall\",band!=\"\",level=~\"L0|L1\",stat=\"value\"}",
          "legendFormat": "{{level}} {{band}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
