    {
      "type": "timeseries",
      "title": "Live: L0 alerts firing",
      "id": 6,
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (alertname) (ALERTS{alertstate=\"firing\",alertname=~\"HighErrorRatio|HighLatencyP99|ContainerOOMKilled|PodCrashLooping|ContainerHighMemory\"})",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Live: incidents opened by the Monitor (per hour)",
      "id": 7,
      "description": "From the shared incident record (D49: the Monitor opens incidents, with the detector that reported them: alert_rule, runtime or ci).",
