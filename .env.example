# Copy to .env and fill in. Never commit .env.
# Read-only GitHub token for the laptop deployer (fine-grained, this repository, Actions: read).
# Optional: without it GitHub allows 60 API requests per hour and the deployer polls every 60 s.
GITHUB_TOKEN_READ=
GITHUB_TOKEN_WRITE=
LLM_API_KEY=
SONAR_TOKEN=
# Extra Groq lanes for the batch Diagnose runs (D41), one per account; optional
# GROQ_KEY_1=
# GROQ_KEY_2=
# GROQ_KEY_3=
# GROQ_KEY_4=
# GROQ_KEY_5=
# Held-out seed (Step 11 only): created by `scenarios/heldout.py commit-seed`, never shared;
# only its SHA-256 is committed (scenarios/heldout-seed.sha256)
# FLOWGUARD_HELDOUT_SEED=
# Deployer overrides (defaults shown)
# FLOWGUARD_REPO=trad024/FlowGuard
# FLOWGUARD_BRANCH=dev
# FLOWGUARD_WORKFLOW=app-ci.yml
# FLOWGUARD_IMAGE=ghcr.io/trad024/flowguard-podinfo
# FLOWGUARD_POLL_SECONDS=60
