# Copy to .env and fill in. Never commit .env.
# Read-only GitHub token for the laptop deployer (fine-grained, this repository, Actions: read).
# Optional: without it GitHub allows 60 API requests per hour and the deployer polls every 60 s.
GITHUB_TOKEN_READ=
GITHUB_TOKEN_WRITE=
LLM_API_KEY=
SONAR_TOKEN=
# Deployer overrides (defaults shown)
# FLOWGUARD_REPO=trad024/FlowGuard
# FLOWGUARD_BRANCH=dev
# FLOWGUARD_WORKFLOW=app-ci.yml
# FLOWGUARD_IMAGE=ghcr.io/trad024/flowguard-podinfo
# FLOWGUARD_POLL_SECONDS=60
